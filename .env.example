# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL
POSTGRES_DB=ecom
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom

# Gunicorn / Nginx
GUNICORN_WORKERS=4
NGINX_PORT=8080

# Bootstrap (created on container start if set)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin12345
SEED_DEMO_DATA=1

# Store
CURRENCY_SYMBOL=৳
SHIPPING_FLAT_RATE=5.00
FREE_SHIPPING_THRESHOLD=5000.00

# Point of sale (optional app). 0 = completely disabled.
POS_ENABLED=1
POS_STORE_NAME=Ecom Store
POS_STORE_ADDRESS=Dhaka, Bangladesh
POS_RECEIPT_FOOTER=Thank you for shopping with us!
POS_MAX_DISCOUNT_PERCENT=20
